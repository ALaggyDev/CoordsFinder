{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-release",
      "displayName": "CPU-only release",
      "binaryDir": "${sourceDir}/build/cpu-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COORDSFINDER_ENABLE_CUDA": "OFF",
        "COORDSFINDER_ENABLE_HIP": "OFF"
      }
    },
    {
      "name": "cuda-release",
      "displayName": "CPU + CUDA release",
      "binaryDir": "${sourceDir}/build/cuda-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COORDSFINDER_ENABLE_CUDA": "ON",
        "COORDSFINDER_ENABLE_HIP": "OFF",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "hip-release",
      "displayName": "CPU + HIP release (AMD)",
      "binaryDir": "${sourceDir}/build/hip-release",
      "toolset": {
        "value": "version=14.44"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COORDSFINDER_ENABLE_CUDA": "OFF",
        "COORDSFINDER_ENABLE_HIP": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx1200", //CHANGE THIS DEPENDING ON UR GPU,
        // SEE https://rocmdocs.amd.com/en/develop/reference/gpu-specs.html AND LOOK FOR LLVM TARGET NAME FOR YOUR GPU
        "CMAKE_HIP_COMPILER": "E:/ROCm/bin/clang-cl.exe",
        "CMAKE_CXX_COMPILER": "E:/ROCm/bin/clang-cl.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "configuration": "Release"
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release",
      "configuration": "Release"
    },
    {
      "name": "hip-release",
      "configurePreset": "hip-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-release",
      "configurePreset": "cuda-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hip-release",
      "configurePreset": "hip-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
